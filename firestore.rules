rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all documents
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read club_codes and create their own
    match /club_codes/{clubCodeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false; // No updates allowed
      // Allow users to delete their own club code (for regeneration)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    
    // Allow read access to user meetings
    match /users/{userId}/meetings/{meetingId} {
      allow read: if true;
      // Allow creator to update their own meetings
      allow update: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow read/write access to polls subcollection
    match /users/{userId}/meetings/{meetingId}/polls/{pollId} {
      allow read: if true;
      // Allow creator to manage polls (create, update, delete)
      allow write: if request.auth != null && request.auth.uid == userId;
      // Voting goes through Cloud Function (submit_vote) which has admin access
    }
    
    // Allow guests to create entries in guests subcollection (for guest entry form)
    match /users/{userId}/guests/{deviceId} {
      // Allow authenticated users (meeting creators) to read all guest entries
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow unauthenticated users to read their own entry (by deviceId)
      allow get: if true; // Needed to check if entry exists today
      allow list: if true; // Needed for listing guests
      allow create: if true; // Anyone can create (guests don't need auth)
      allow update: if true; // Allow updates for attendance_count and last_entry_date
      allow delete: if request.auth != null && request.auth.uid == userId; // Only creator can delete
      
      // Allow creating/reading attendances subcollection
      match /attendances/{entryDate} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow get: if true; // Allow checking if attendance exists
        allow create: if true; // Anyone can create attendance entries
        allow update: if false; // No updates allowed
        allow delete: if request.auth != null && request.auth.uid == userId; // Only creator can delete
      }
    }
    
    // Active meetings - allow read only (to get creator_id), no writes (only Cloud Functions can write)
    match /active_meetings/{meetingId} {
      allow read: if true; // Need to read to get creator_id for finding user's meeting
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Default: no write access to other documents
    match /{document=**} {
      allow write: if false;
    }
  }
}