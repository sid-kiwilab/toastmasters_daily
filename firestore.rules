rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all documents
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow read access to polls field in user meetings
    match /users/{userId}/meetings/{meetingId} {
      allow read: if true;
    }
    
    // Allow anyone to write to polls field in user meetings (for voting)
    match /users/{userId}/meetings/{meetingId} {
      allow write: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['polls']);
    }
    
    // Default: no write access to other documents
    match /{document=**} {
      allow write: if false;
    }
  }
}