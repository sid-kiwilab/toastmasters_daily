rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all documents
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read club_codes and create their own
    match /club_codes/{clubCodeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false; // No updates allowed
      allow delete: if false; // No deletes allowed
    }
    
    // Allow read access to user meetings
    match /users/{userId}/meetings/{meetingId} {
      allow read: if true;
      // Allow writes to agenda_url field (for agenda uploads)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agenda_url']);
    }
    
    // Allow read/write access to polls subcollection
    match /users/{userId}/meetings/{meetingId}/polls/{pollId} {
      allow read: if true;
      // Allow creator to manage polls (create, update, delete)
      allow write: if request.auth != null && request.auth.uid == userId;
      // Voting goes through Cloud Function (submit_vote) which has admin access
    }
    
    // Active meetings - allow read only (to get creator_id), no writes (only Cloud Functions can write)
    match /active_meetings/{meetingId} {
      allow read: if true; // Need to read to get creator_id for finding user's meeting
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Default: no write access to other documents
    match /{document=**} {
      allow write: if false;
    }
  }
}